# .env.example
# ---------------------------------------------------------
# 這是「範本」，可以且應該進 Git 版控，讓其他人知道要填哪些變數。
# 使用方式：複製一份改名叫 .env，再把下面的值換成真實的密碼/金鑰。
# .env 本身「不要」進版控（.gitignore 已經幫你排除了）。
# ---------------------------------------------------------

# --- PostGIS 資料庫設定 ---
POSTGRES_USER=gis_user
POSTGRES_PASSWORD=change_this_password
POSTGRES_DB=bmc_navigation
DB_PORT=5432

# --- FastAPI 後端設定 ---5
BACKEND_PORT=8000
OPENAI_API_KEY=sk-your-real-key-here

# --- Next.js 前端設定 ---
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- pgAdmin 設定（網頁版資料庫管理工具） ---
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change_this_password
PGADMIN_PORT=5050
